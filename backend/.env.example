###############################################
# 🔐 SECURITY & SERVER CONFIGURATION
###############################################

# Secret key for JWT authentication
# Example: Quantum.369
JWT_SECRET=

# Port number on which the backend server runs
# Example: 27017
PORT=

###############################################
# 🌐 FRONTEND & CORS SETTINGS
###############################################

# Allowed origins for CORS (comma-separated if multiple)
# Example: https://example.com,https://admin.example.com
CORS_ORIGINS=

# Base URL of the website
# Example: https://example.com
WEBSITE=

###############################################
# 📂 FILE STORAGE CONFIGURATION
###############################################

# Directory for uploaded files
# Example: application/hrms/production/john_doe
UPLOAD_DIR=

###############################################
# 🗄️ DATABASE CONFIGURATION
###############################################

# MongoDB connection URI
# Example: mongodb://localhost:27017/hrms
MONGO_DB_URI=

###############################################
# 🏢 COMPANY DETAILS
###############################################

# Company logo URL or path
# Example: https://example.com/logo.png
COMPANY_LOGO=

# Company name
# Example: Quantum Solutions Ltd.
COMPANY_NAME=

###############################################
# 📧 EMAIL / SMTP SETTINGS
###############################################

# SMTP mail server host
# Example: smtp.zoho.com
MAIL_HOST=

# Port for the SMTP host (commonly 465 for SSL or 587 for TLS)
# Example: 465
MAIL_PORT=

# Email address used as the sender
# Example: noreply@quantum.com
MAIL=

# Password or app-specific password for the sender email
# Example: MySecureAppPassword123
MAIL_PASSWORD=

# Build

# Resend (https://resend.com) - email sending
RESEND_API_KEY=
# Verified sender, e.g. HRMS <no-reply@yourdomain.com>
MAIL_FROM=

# File uploader service endpoint (required for uploads)
FILE_UPLOADER_URL=
# Bot-alert recipient (security alerts are skipped if unset)
HR_EMAIL=
# Optional tunables (defaults in src/config/app.config.ts):
# SESSION_DAYS=15  BCRYPT_ROUNDS=12  PASSWORD_MIN_LENGTH=8  PIN_TTL_MINUTES=15
# LOGIN_RATE_MAX=10  LOGIN_RATE_WINDOW_MS=900000  PIN_RATE_MAX=5  PIN_RATE_WINDOW_MS=900000
# BOT_RATE_MAX=10  BOT_RATE_WINDOW_MS=60000  BODY_LIMIT=1mb  UPLOAD_MAX_BYTES=5242880  UPLOAD_MAX_FILES=5
