# Google Maps API Key
VITE_APP_GOOGLE_MAPS_API_KEY=your_google_maps_api_key_here

# AI Summary (Progress Reports) - use one of the options below (free options first)
# Option A: Groq (free tier, no credit card) — https://console.groq.com
VITE_GROQ_API_KEY=your_groq_api_key_here
# Optional: Groq model (default: llama-3.1-8b-instant). Also try llama-3.3-70b-versatile
# VITE_GROQ_MODEL=llama-3.1-8b-instant

# Option B: Google AI Studio (Gemini)
VITE_GOOGLE_AI_STUDIO_API_KEY=your_google_ai_studio_api_key_here
# Optional: Gemini model (default: gemini-2.0-flash). If 404, try gemini-1.5-flash-latest
# VITE_GOOGLE_AI_STUDIO_MODEL=gemini-2.0-flash

# Optional: Force provider (groq | google | browser). Default: groq if Groq key set, else google, else browser (Chrome 138+)
# VITE_AI_SUMMARY_PROVIDER=groq

# Backend API URL
VITE_API_URL=https://api.yourdomain.com

# Company Information
VITE_COMPANY_NAME="QUANTUM CLOUD CORPORATION"
VITE_COMPANY_ADDRESS="HLR BLDG, Villa Amparo Subdivision, B1 L23 Padua St, Imus, 4103 Cavite"

# Company Branding Assets (URLs or relative paths)
VITE_COMPANY_LOGO=/assets/images/company-logo.png
VITE_COMPANY_LIGHT_LOGO=/assets/images/company-logo-light.png
VITE_COMPANY_LETTER_LOGO=/assets/images/company-letter-logo.png

# Application Display Name or Environment
VITE_DISPLAY=production

# Set to false to hide the floating DEVELOPMENT/STAGING badge
# VITE_SHOW_ENV_BANNER=false

# File Upload API URL
VITE_UPLOADER_API_URL=https://uploader.yourdomain.com

# Geo-fencing
VITE_GEO_FENCE_POLYGON="14.413024,120.939348;14.413063,120.939655;14.413280,120.939598;14.413244,120.939330;||14.415576,120.938988;14.415544,120.938795;14.415369,120.938814;14.415448,120.939040;"

# Build

# Chatbot webhook (chatbot disabled if unset)
VITE_CHATBOT_WEBHOOK_URL=
