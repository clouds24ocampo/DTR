# Compose variables. Copy to .env.docker and fill in:
#   cp .env.docker.example .env.docker
# Compose usage: docker compose --env-file .env.docker up -d --build

# Local mongo inside compose (change db name if you like; keep the mongo host).
MONGO_DB_URI=mongodb://mongo:27017/hrms

# REQUIRED — secrets / URLs for the public deployment:
JWT_SECRET=change-me-to-a-long-random-string
CORS_ORIGINS=https://your-domain.com
SEED_ADMIN_PASSWORD=change-me-strong-password

# Optional backend settings:
WEBSITE=https://your-domain.com
COMPANY_NAME=QUANTUM CLOUD CORPORATION
COMPANY_LOGO=
UPLOAD_DIR=
RESEND_API_KEY=
MAIL_FROM=
FILE_UPLOADER_URL=
SEED_ADMIN_EMAIL=admin@quantumcloud.com
